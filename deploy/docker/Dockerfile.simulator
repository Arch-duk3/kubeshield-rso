# --- Build Stage ---
FROM golang:1.24-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git

# Copy dependency files first for caching
COPY go.mod ./
# No go.sum yet, will be generated
RUN go mod download

# Copy source
COPY . .

# Build statically linked binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o krsi-simulator ./main.go

# --- Final Stage ---
FROM alpine:latest

WORKDIR /app

# Install runtime dependencies
RUN apk add --no-cache ca-certificates

# Copy binary from builder
COPY --from=builder /app/krsi-simulator .

# Expose API port
EXPOSE 8080

# Default environment variables
ENV LOG_LEVEL=INFO
ENV PORT=8080

# Run simulator
ENTRYPOINT ["./krsi-simulator"]
CMD ["--port=8080", "--log-level=INFO"]
